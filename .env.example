# Optional — overrides the deployed backend in services/api.ts.
# Only needed when running the local backend (cd backend && npm run dev).
#
# Simulator / web:      http://localhost:3001
# Physical device:      http://<your-machine-LAN-IP>:3001
#
# Note: Android blocks cleartext HTTP in release builds, so an http:// value
# works in development only. Restart the dev server after changing this —
# EXPO_PUBLIC_* vars are inlined at build time.
# EXPO_PUBLIC_API_URL=http://localhost:3001
